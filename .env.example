# Copy this file to .env on the Win10 deployment machine.
# Do not commit real values.

EAZYGAME_ENV=local
EAZYGAME_HOST=127.0.0.1
EAZYGAME_PORT=39200

# Existing module path. Relative paths are resolved from this project directory.
WX_MINI_RANK_MONITOR_DIR=../wx-mini-rank-monitor

# DeepSeek. Leave empty until AI routing or summarization is enabled.
DEEPSEEK_API_KEY=

# WeCom smart robot long connection. Leave empty until robot service is enabled.
WECOM_SMART_BOT_ID=
WECOM_SMART_BOT_SECRET=

# Notification channels. Leave empty until notification center is enabled.
WECOM_GROUP_WEBHOOK_URL=
WECOM_APP_CORP_ID=
WECOM_APP_AGENT_ID=
WECOM_APP_SECRET=
WECOM_APP_TO_USER=

# WeCom document API app for development progress monitor.
WECOM_DOC_CORP_ID=
WECOM_DOC_AGENT_ID=
WECOM_DOC_SECRET=
