      "内网测试进度": "0%",
      "正式验收进度": "0%",
      "正式测试进度": "0%"
    },
    "writeRequiresSubmitterConfirm": true
  },
  "stages": {
    "sequence": [
      "规划中",
      "设计中",
      "实现中",
