    ],
    "dailyIncludedStages": [
      "设计中",
      "实现中",
      "内网验收/测试中",
      "正式验收/测试中",
      "上线前整备"
    ],
    "onlineStages": [
      "待上线",
      "已上线"
    ],
    "assigneeFieldsByStage": {
      "设计中": [
        "策划人员"
      ],
      "实现中": [
        "UI人员",
        "动效人员",
        "前端开发",
        "后端开发"
      ],
      "内网验收/测试中": [
        "策划人员",
        "测试人员"
      ],
      "正式验收/测试中": [
        "策划人员",
        "测试人员"
      ],
      "上线前整备": [
        "策划人员"
      ],
      "待上线": [
        "策划人员"
      ],
      "已上线": [
        "策划人员"
      ]
