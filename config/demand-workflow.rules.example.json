      "前端组长",
      "后端组长",
      "测试组长"
    ],
    "leaderSupplementFields": {
      "UI组长": [
        "UI制作交付日期",
        "UI监修完成日期"
      ],
      "动效组长": [
        "动效制作交付日期",
